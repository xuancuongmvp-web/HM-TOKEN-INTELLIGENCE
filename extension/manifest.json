{
  "manifest_version": 3,
  "name": "HM Prompt Monitor",
  "version": "0.1.0",
  "description": "Local, on-page prompt quality and token-efficiency hints for ChatGPT.",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "action": {
    "default_title": "Analyze current ChatGPT prompt",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }]
}