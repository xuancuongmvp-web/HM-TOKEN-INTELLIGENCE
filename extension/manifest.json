{
  "manifest_version": 3,
  "name": "HM Prompt Monitor",
  "version": "0.2.0",
  "description": "Local prompt-quality hints for ChatGPT Web, independent of ChatGPT subscription tier.",
  "host_permissions": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
  "action": {
    "default_title": "Analyze current ChatGPT prompt",
    "default_popup": "popup.html"
  },
  "content_scripts": [{
    "matches": ["https://chatgpt.com/*", "https://chat.openai.com/*"],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_idle"
  }]
}
